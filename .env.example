# Neon Postgres: use a development branch locally, not production.
DATABASE_URL=
# Neon env pull supplies the direct URL for Prisma migrations.
DATABASE_URL_UNPOOLED=
# Optional override for the direct Prisma migration connection.
DIRECT_URL=

# Neon Object Storage: run `neon env pull` for the branch credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_STORAGE_BUCKET=assets

# Better Auth. Generate a unique local value; never commit the real secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional email remains provider-neutral and is not enabled for real sends.
EMAIL_MODE=console
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_SMTP_URL=

# Google OAuth is planned but not enabled until separately approved.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
